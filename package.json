		"@types/mocha": "^10.0.7",
		"@types/node": "^20.19.43",
		"@types/pdf-parse": "^1.1.4",
		"@types/picomatch": "^4.0.3",
		"@types/shell-quote": "^1.7.5",
		"@types/should": "^11.2.0",
		"@types/sinon": "^17.0.4",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "1.84.2",
		"@types/ws": "^8.18.1",
		"adm-zip": "^0.6.1",
		"c8": "^10.1.3",
		"chai": "^4.3.10",
		"chalk": "^5.6.2",
		"cross-env": "^10.1.0",
		"dotenv": "^17.2.4",
		"esbuild": "^0.28.1",
		"grpc-tools": "^1.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.0",
		"minimatch": "^3.0.3",
		"npm-run-all": "^4.1.5",
		"nyc": "^17.1.0",
		"prebuild-install": "^7.1.3",
		"protoc-gen-ts": "^0.8.7",
		"rimraf": "^6.1.3",
		"should": "^13.2.3",
		"sinon": "^19.0.2",
		"tree-kill": "^1.2.2",
		"ts-morph": "^27.0.2",
		"ts-node": "^10.9.2",
		"ts-proto": "^2.11.8",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.1",
		"typescript": "^5.4.5",
		"wrangler": "^4.136.1"
	},
