          "requires_approval": {
            "type": "boolean",
            "description": "Optional legacy risk hint: true for destructive/modifying commands, false for read-only commands. The execution policy determines authorization; omitting this hint does not require a separate confirmation."
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    }
  },
