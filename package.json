		"@google/genai": "^1.45.0",
		"@grpc/grpc-js": "^1.9.15",
		"@grpc/reflection": "^1.0.4",
		"@mistralai/mistralai": "^1.14.1",
		"@modelcontextprotocol/sdk": "^1.25.1",
		"@noorm/broccolidb": "https://github.com/CardSorting/ABroccoliDB/archive/77a1814f7c8549d8cce4da6df3e633468d178450.tar.gz",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.8.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.219.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.219.0",
