          "type": "STRING"
        }
      },
      "required": [
        "result"
      ]
    }
  },
  {
    "name": "roadmap",
    "description": "Per-project ROADMAP.md steering — living checkpoint for center of gravity, Now/Next/Later, code soup audit, and completion gates. Governance (validate, bootstrap autofill, checkpoint date) runs automatically at attempt_completion — roadmap(action='validate') is diagnostic only. Responses include project_identity_line, governance_policy, _roadmap_operator_hints, agent_playbook, and recommended_next_action.",
    "parameters": {
      "type": "OBJECT",
      "properties": {
        "action": {
          "type": "STRING"
        },
        "context": {
          "type": "STRING"
        },
        "user_request": {
          "type": "STRING"
        },
        "task_progress": {
          "type": "STRING"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
