{
	"name": "heav3ns",
	"description": "HEAV3NS is a focused, local-first CLI coding agent for reviewable developer workflows.",
	"version": "14.1.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"author": {
		"name": "William Andrew Cruz (CardSorting)"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/CardSorting/HEAV3NS-CODE.git"
	},
	"files": [
		"dist",
		"!dist/releases",
		"!dist/gumroad",
		"!dist/**/*.map",
		"README.md",
		"PRODUCT.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"PATENT-NON-AGGRESSION-PLEDGE.md",
		"TRADEMARKS.md",
		"THIRD-PARTY-NOTICES.md",
		"LICENSE-MAP.md",
		"SECURITY.md"
	],
	"homepage": "https://dietcode.io",
	"keywords": [
		"heav3ns",
		"dietcode",
		"claude",
		"dev",
		"mcp",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"cli"
	],
	"scripts": {
		"check": "npm run check-types && tsc --noEmit -p tsconfig.worker.json",
		"ip:check": "node scripts/check-ip-claims.mjs",
		"provenance:check": "node scripts/check-provenance.mjs",
		"license:check": "node scripts/check-licensing.mjs",
		"package:check": "node scripts/check-package-boundary.mjs --pack",
		"legal:check": "npm run license:check && npm run ip:check && npm run provenance:check && node scripts/check-package-boundary.mjs",
		"dco:check": "node scripts/check-dco.mjs",
		"build": "npm run protos && node esbuild.mjs --production",
		"test": "npm run test:unit && npm run benchmark:flight",
		"smoke": "node --import tsx src/index.ts --smoke",
		"benchmark": "node --import tsx src/index.ts --benchmark",
		"benchmark:parent-io": "node --import tsx scripts/benchmark-parent-io.ts",
		"benchmark:flight": "node --import tsx scripts/benchmark-agent-flight.ts",
		"baseline:update": "node --import tsx src/index.ts --baseline",
		"guardrail": "node --import tsx scripts/validate-repo.ts",
		"validate:adr": "node --import tsx scripts/validate-adr-workspace.ts",
		"validate:project-knowledge": "node --import tsx scripts/validate-project-knowledge.ts",
		"knowledge:bootstrap": "node --import tsx scripts/validate-project-knowledge.ts --bootstrap",
		"validate:cache": "node --import tsx scripts/validate-prompt-cache.ts",
		"token:add": "node --import tsx scripts/add-token.ts",
		"login": "node --import tsx scripts/login.ts",
		"worker:types": "wrangler types src/worker-configuration.d.ts",
		"worker:types:check": "wrangler types src/worker-configuration.d.ts --check",
		"worker:build": "wrangler deploy --dry-run",
		"start": "node dist/index.js",
		"prepublishOnly": "npm run check-types && npm run lint && npm run build",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"dev": "npm run protos && npm run watch",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run lint && node esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"postprotos": "biome format src/shared/proto src/core/controller src/hosts/ src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist src/generated out/",
		"clean:deps": "rimraf node_modules",
		"clean:all": "npm run clean:build && npm run clean:deps",
		"check-types": "npm run protos && tsc --noEmit --incremental",
		"lint": "biome lint --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && npm run lint:proto && npm run check:handler-imports && npm run check:task-lifecycle-boundary",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"format": "biome format --changed --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error",
		"format:fix": "biome check --changed --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"fix:all": "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe",
		"audit:adr": "npx tsx scripts/audit-adr.ts",
		"scaffold:adr": "npx tsx scripts/scaffold-adr.ts",
		"export:adr": "npx tsx scripts/export-adr.ts",
		"docs:check-repo": "npm-run-all -p docs:check-agent-links docs:check-agent-branding docs:check-root-readme docs:check-root-readme-links docs:check-docs-readme docs:check-readme-metrics audit:adr export:adr",
		"ci:check-all": "npm-run-all -s check-types lint format",
		"ci:build": "npm run build",
		"pretest": "npm run compile && npm run lint",
		"test:unit": "cross-env TSX_TSCONFIG_PATH=./tsconfig.unit-test.json TS_NODE_PROJECT=./tsconfig.unit-test.json mocha --config .mocharc.cli.json",
		"test:unit:update-snapshots": "cross-env TSX_TSCONFIG_PATH=./tsconfig.unit-test.json TS_NODE_PROJECT=./tsconfig.unit-test.json UPDATE_SNAPSHOTS=true mocha --config .mocharc.cli.json",
		"test:legacy-host": "cross-env TSX_TSCONFIG_PATH=./tsconfig.unit-test.json TS_NODE_PROJECT=./tsconfig.unit-test.json mocha --config .mocharc.legacy-host.json",
		"benchmark:meow-io": "cross-env TS_NODE_TRANSPILE_ONLY=1 ts-node -P tsconfig.unit-test.json -r tsconfig-paths/register scripts/meow-io-benchmark.ts",
		"roadmap:audit": "node --import tsx scripts/roadmap_audit.ts",
		"test:qol": "cross-env TSX_TSCONFIG_PATH=./tsconfig.unit-test.json node --import tsx --import ./src/test/register-vscode-mock.mjs node_modules/mocha/bin/mocha.js --no-config --require ./src/test/requires.cjs --timeout 30000 --exit \"src/services/roadmap/__tests__/*.test.ts\" src/core/task/tools/io/__tests__/parentIoThroughput.test.ts src/tui/components/__tests__/agentActivityTimeline.test.ts \"src/core/task/tools/completion/__tests__/*.test.ts\" src/core/task/tools/__tests__/completionGatePipeline.test.ts \"src/core/prompts/system-prompt/__tests__/*.test.ts\" \"src/core/task/tools/subagent/__tests__/governedExecutionRoadmap*.test.ts\"",
		"install:all": "npm install",
		"check:handler-imports": "node scripts/check-handler-imports.mjs",
		"check:task-lifecycle-boundary": "node scripts/check-task-lifecycle-boundary.mjs",
		"prepare": "node -e \"if (require('node:fs').existsSync('.git')) try { require('node:child_process').execSync('npx husky', { stdio: 'inherit' }); } catch {}\"",
		"docs": "cd docs && npm run dev",
		"docs:check-links": "cd docs && npm run check",
		"docs:check-agent-links": "node scripts/check-agent-docs-links.mjs",
		"docs:check-agent-branding": "node scripts/check-agent-docs-branding.mjs",
		"docs:check-root-readme": "node scripts/check-root-readme.mjs",
		"docs:check-docs-readme": "node scripts/check-docs-readme.mjs",
		"docs:check-all": "npm-run-all docs:check-agent-links docs:check-agent-branding docs:check-root-readme docs:check-root-readme-links docs:check-docs-readme docs:check-readme-metrics docs:check-links",
		"docs:check-readme-metrics": "node scripts/check-readme-metrics.mjs",
		"docs:check-root-readme-links": "node scripts/check-root-readme-links.mjs",
		"docs:tag-legacy-providers": "node scripts/tag-legacy-provider-docs.mjs",
		"docs:rename-file": "cd docs && npm run rename",
		"report-issue": "node scripts/report-issue.js",
		"build:cli": "npm run build",
		"desktop:build": "bash scripts/build-desktop.sh",
		"desktop:test": "TSX_TSCONFIG_PATH=./tsconfig.unit-test.json node --import tsx --import ./src/test/register-vscode-mock.mjs node_modules/mocha/bin/mocha.js --no-config --require ./src/test/requires.cjs --timeout 30000 'src/desktop/__tests__/*.test.ts'",
		"desktop:test:native": "bash scripts/test-desktop-native.sh",
		"desktop:build:macos": "bash scripts/build-desktop.sh macos",
		"package:dmg": "bash scripts/package-dmg.sh",
		"publish:ota": "bash scripts/publish-ota-engine.sh"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add proto/dietcode/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@bufbuild/buf": "^1.54.0",
		"@types/adm-zip": "^0.5.8",
		"@types/chai": "^5.0.1",
		"@types/chokidar": "^1.7.5",
		"@types/clone-deep": "^4.0.4",
		"@types/diff": "^5.2.1",
		"@types/express": "^5.0.6",
