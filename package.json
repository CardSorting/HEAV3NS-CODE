	"overrides": {
		"tar-fs": ">=3.1.1",
		"tar": "^7.5.17",
		"vite": "^7.1.11",
		"js-yaml": "^4.1.1",
		"@opentelemetry/core": "^2.8.0",
		"mocha": {
			"diff": "^8.0.3"
		},
		"sinon": {
			"diff": "^8.0.3"
		},
		"serialize-javascript": "^7.0.5",
		"esbuild": "^0.28.1",
		"uuid": "$uuid"
	},
	"c8": {
		"reporter": [
			"lcov",
			"html"
		],
		"exclude": [
			"**/.vscode-test/**",
			"**/node_modules/**",
			"node_modules",
			"**/*.d.ts",
			"**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}",
			"**/__tests__/**",
			"**/test/**",
			"**/tests/**",
			"**/.nyc_output/**",
			"**/tests-results/**",
			"src/test/**",
			"**/src/xml/**",
			"**/src/generated/**",
			"dist"
		],
		"all": true,
		"exclude-after-remap": true
	},
	"bin": {
		"heav3ns": "dist/index.js",
		"heav3ns-joy": "dist/index.js",
		"lumi": "dist/index.js",
		"lumi-joy": "dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"type": "module"
}
